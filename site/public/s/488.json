{"t":"اللائحة التنفيذية للموارد البشرية في الخدمة المدنية — نسخة الوزارة المنشورة يناير2026","m":{"أداة الإصدار":"","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 187","b":"يجوز للجهة الحكومية التي يعمل بها المبتعث إنهاء بعثته في الحالات الآتية:\n\nأ- إذا ظهر من التقارير الدراسية عنه عدم إمكانية تحقيق الغرض المبتعث من أجله.\n\nب- إذا غيّر التخصص المبتعث من أجله دون أخذ الموافقة المسبقة من قبل الجهة الحكومية التي يعمل بها.\n\nج- إذا انتقل من جامعة إلى أخرى أو من فرع للجامعة إلى آخر خارج المدينة التي بها هذا الفرع دون أخذ الموافقة المسبقة من الجهة الحكومية التي يعمل بها.\n\nد- إخلاله بواجباته كمبتعث للدراسة. وفي هذه الحالات يجوز للجهة الحكومية التي يعمل بها المبتعث إلزامه بدفع بعض أو كل ما صرف عليه من بدلات ومخصصات لغرض الابتعاث.","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"hr-executive","legal_key":"187","body_sha256":"66b7625ca1a49eaf01484ac79d7f9de0a516fc985dcda9c82ae85cba8d505019","archived_body_sha256":"66b7625ca1a49eaf01484ac79d7f9de0a516fc985dcda9c82ae85cba8d505019","source_path":"legislation/human-resources/hr-executive/OFFICIAL_TEXT.md","body_record_path":"legislation/human-resources/hr-executive/working/CONSUMER_ARTICLES.json","version_scope":"ministry_pdf_embedded_text_articles_1_261; annexes_and_forms_excluded; amendment_inventory_and_currentness_not_established","verification_summary":{"official_match":{"status":"VERIFIED","label_ar":"موثق ضمن النطاق المسجل","scope":"saved_pdf_embedded_text_automated_character_match_tables_may_lose_layout","as_of":"2026-10-12","evidence":["legislation/human-resources/hr-executive/metadata.json","legislation/human-resources/hr-executive/OFFICIAL_TEXT.md"]},"amendments":{"status":"UNKNOWN","label_ar":"غير محسوم","scope":"غير معروف؛يتطلب إثباتاً مستقلاً","as_of":"2026-10-12","evidence":[]},"publication":{"status":"UNKNOWN","label_ar":"غير محسوم","scope":"غير معروف؛يتطلب إثباتاً مستقلاً","as_of":"2026-10-12","evidence":[]},"effectiveness":{"status":"UNKNOWN","labe