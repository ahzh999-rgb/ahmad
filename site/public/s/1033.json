{"t":"قواعد إقرار الأحكام المنظمة لشؤون العاملين في الأجهزة العامة وتعويضاتهم","m":{"أداة الإصدار":"","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 6","b":"المادة السادسة:\n1- على الجهاز الذي لديه متعاقدون من خلال برامج أو بنود التشغيل أو من خلال أي نمط آخر يُستخدم للتعاقد، إعداد لائحة إدارية مشتملةً على البدلات والمكافآت والمزايا الأخرى، وسلم رواتب للعاملين المتعاقد معهم من خلال تلك الأنماط في الجهاز، مع الالتزام بالنماذج والمعايير والقوائم الموحدة، وللجهاز التنسيق فيما يلزم حيال ذلك مع الوزارة.\n2- تكون صلاحية إقرار اللائحة الإدارية وسلم رواتب العاملين، المشار إليهما في الفقرة (1) من هذه المادة -فيما لم يرد به نص نظامي- للمجلس أو الوزير المختص بحسب الأحوال.\n","eligible":true,"body_kind":"OWNER_ACCEPTED","instrument_id":"public-employees-compensation-rules","legal_key":"6","body_sha256":"cb9da7401d72a39813df10df2b925fd0b3dffcb5ff217195409cde0947738684","archived_body_sha256":"cb9da7401d72a39813df10df2b925fd0b3dffcb5ff217195409cde0947738684","source_path":"sources/hr-and-procurement/public-employees-compensation-rules.html","body_record_path":"legislation/human-resources/public-employees-compensation-rules/ARTICLE_SOURCE_INDEX.json","version_scope":"original_official_publication_only_not_latest_consolidation","verification_summary":{"official_match":{"status":"VERIFIED","label_ar":"موثق ضمن النطاق المسجل","scope":"original_official_publication_only_not_latest_consolidation","as_of":"2026-10-12","evidence":["legislation/human-resources/public-employees-compensation-rules/metadata.json"]},"amendments":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"اعتماد المالك للحصر منفصل عن الحصر المستقل","as_of":"2026-10-12","evidence":["legislation/human-resources/public-employees-compensation-rules/metadata.json"]},"publication":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"بيانات ناشر أو شاهد مسجل؛حدود الإثبات محفوظة","as_of":"2026-10-12","evidence":["legislation/human-resources/public-employee