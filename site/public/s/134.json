{"t":"نظام المنافسات والمشتريات الحكومية (1448هـ)","m":{"أداة الإصدار":"royal_decree م/76 1448/02/27","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 36","b":"1- تقدم العروض مشفرةً من خلال البوابة، وفقًا لما تحدده اللائحة.\n2- تقدم العروض في المدة المحددة لقبولها، ولا يجوز قبولها في غير تلك المدة.\n3- تقدم العروض في ظروف مغلقة مختومة إذا تعذر تقديمها من خلال البوابة لأسباب فنية أو لأسباب تتعلق بالأمن الوطني.\n4- تعلن الجهة الحكومية عن أسماء الأشخاص الذين تقدموا بعروضهم من خلال البوابة. وإذا تعذر استخدام البوابة لأسباب فنية أو لأسباب تتعلق بالأمن الوطني؛ فتعلن عن ذلك بالوسيلة التي تحددها اللائحة.","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"SA-LAW-GTP-1448-001","legal_key":"36","body_sha256":"4f4f9a59b6d99e764ad9c7f17a421690d291596fce4fd3f3120cdb6bde0a16e8","archived_body_sha256":"4f4f9a59b6d99e764ad9c7f17a421690d291596fce4fd3f3120cdb6bde0a16e8","source_path":"sources/executive-regulation-1441/1448-law-live-2026-10-18.html","body_record_path":"legislation/laws/SA-LAW-GTP-1448-001/articles.json","version_scope":"official_HTML_snapshot_2026-10-18_only_not_currentness_or_point_in_time","verification_summary":{"official_match":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"99/101 متن مادة مقابل مع HTML؛لا ادعاء مقابلة PDF أو حداثة النص","as_of":"2026-10-18","evidence":["legislation/laws/SA-LAW-GTP-1448-001/OFFICIAL_HTML_COLLATION_2026-10-18.json","sources/executive-regulation-1441/1448-law-live-2026-10-18.html"]},"amendments":{"status":"UNKNOWN","label_ar":"غير محسوم","scope":"غير معروف؛يتطلب إثباتاً مستقلاً","as_of":"2026-10-12","evidence":[]},"publication":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"تاريخ النشر2026-09-04/1448-03-22 ظاهر بصفحات الناشر؛رقم العدد5180 وصفحاته لم يثبتا بهذه الصفحات","as_of":"2026-10-18","evidence":["analysis/LAW1448_ISSUANCE_EVIDENCE_2026-10-18.json","analysis/LAW1448_ISSUANCE_SNAPSHOT_MANIFEST_2026-10-18.json","sources/executive-regulation-1441/1448-decree-live-2026