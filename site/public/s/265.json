{"t":"نظام الخدمة المدنية","m":{"أداة الإصدار":"royal_decree م/49 1397/07/10","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 7","b":"تعلن وزارة الموارد البشرية والتنمية الاجتماعية عن الوظائف التي في المرتبة (العاشرة) فما دون وما يعادلها في سلالم رواتب الخدمة المدنية، ويخضع جميع المتقدمين لشغل هذه الوظائف لتقويم تحدد وزارة الموارد البشرية والتنمية الاجتماعية مقاييسه وإجراءاته في ضوء متطلبات الوظائف، ويجوز بعد اتفاق وزير الموارد البشرية والتنمية الاجتماعية والوزير المختص؛ أن تعلن الجهة الإدارية عن الوظائف التي يتفق في شأنها وفق المقاييس والإجراءات التي تحددها وزارة الموارد البشرية والتنمية الاجتماعية.","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"civil-service","legal_key":"7","body_sha256":"07e1584c104a7c80a6ccee631fc7f178a3af74844b208d2599ed352337124b7d","archived_body_sha256":"07e1584c104a7c80a6ccee631fc7f178a3af74844b208d2599ed352337124b7d","source_path":"sources/hr-and-procurement/civil-service.pdf","body_record_path":"legislation/human-resources/civil-service/ARTICLE_SOURCE_INDEX.json","version_scope":"ministry1442_snapshot_not_current2026_consolidation","verification_summary":{"official_match":{"status":"VERIFIED","label_ar":"موثق ضمن النطاق المسجل","scope":"ministry_1442_compilation_pdf_only_not_latest_consolidation","as_of":"2026-10-12","evidence":["legislation/human-resources/civil-service/metadata.json","legislation/human-resources/civil-service/OFFICIAL_TEXT.md"]},"amendments":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"اعتماد المالك للحصر منفصل عن الحصر المستقل","as_of":"2026-10-12","evidence":["legislation/human-resources/civil-service/metadata.json"]},"publication":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"ترويسة العدد 2682 من أرشيف مصور مستقل؛ اعتمدها المالك","as_of":"2026-10-12","evidence":["legislation/human-resources/civil-service/VERIFICATION_DOSSIER.json","sources/civil-service/uqn2682-1397-page1.png","legis