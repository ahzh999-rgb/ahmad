{"t":"نظام المنافسات والمشتريات الحكومية (1448هـ)","m":{"أداة الإصدار":"royal_decree م/76 1448/02/27","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 51","b":"1- فيما لم يرد في شأنه نص خاص في النظام، تكون صلاحية البتّ في جميع الإجراءات واتخاذ القرارات وفقًا لأحكام النظام واللائحة لرئيس الجهة الحكومية، وله تفويض من يراه من مسؤولي الجهة الحكومية بما لا يزيد على (خمسين) مليون ريال، على أن يراعى التدرج في التفويض بحسب مسؤولية الشخص المفوض.\n2- استثناء من حكم الفقرة (1) من هذه المادة، يجوز لرئيس الجهة الحكومية أن يفوض من يراه من مسؤولي الجهة الحكومية لتوقيع العقود وغيرها من الوثائق التي تتطلب توقيعًا من رئيس الجهة الحكومية.","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"SA-LAW-GTP-1448-001","legal_key":"51","body_sha256":"94d2c9ee56a862ea34fdd9adbd80ddddec55ea8fa0f873670b24b425a7c7b28f","archived_body_sha256":"7d3f1624ff39e1496912d4de803d64140c887608da73071b7d21a272b2d010fc","source_path":"sources/executive-regulation-1441/1448-law-live-2026-10-18.html","body_record_path":"legislation/laws/SA-LAW-GTP-1448-001/articles.json","version_scope":"official_HTML_snapshot_2026-10-18_only_not_currentness_or_point_in_time","verification_summary":{"official_match":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"99/101 متن مادة مقابل مع HTML؛لا ادعاء مقابلة PDF أو حداثة النص","as_of":"2026-10-18","evidence":["legislation/laws/SA-LAW-GTP-1448-001/OFFICIAL_HTML_COLLATION_2026-10-18.json","sources/executive-regulation-1441/1448-law-live-2026-10-18.html"]},"amendments":{"status":"UNKNOWN","label_ar":"غير محسوم","scope":"غير معروف؛يتطلب إثباتاً مستقلاً","as_of":"2026-10-12","evidence":[]},"publication":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"تاريخ النشر2026-09-04/1448-03-22 ظاهر بصفحات الناشر؛رقم العدد5180 وصفحاته لم يثبتا بهذه الصفحات","as_of":"2026-10-18","evidence":["analysis/LAW1448_ISSUANCE_EVIDENCE_2026-10-18.json","analysis/LAW1448_ISSUANCE_SNAPSHOT_MANIFEST_2026-10-18.json","sources/executive-regulation-14