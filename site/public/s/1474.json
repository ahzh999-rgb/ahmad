{"t":"نظام التقاعد العسكري — النص المنشور لدى التأمينات","m":{"أداة الإصدار":"royal_decree م/24 1395/04/05","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 10-bis","b":"المادة (10) مكرر:\nأ - يحجز على المعاش أو المكافأة بأمر من رئيس مجلس الوزراء إن كان متعلقاً بديون الحكومة، أو بحكم قضائي إن كان متعلقًا بغير ديون الحكومة، على ألا تتجاوز نسبة الحجز (25%)، وفي جميع الأحوال يقدم دين النفقة على غيره من الديون دون التقيد بهذه النسبة.\nب - للمؤسسة العامة للتأمينات الاجتماعية امتياز على جميع الدائنين بتحصيل حقوقها عدا دين النفقة، وتحسم مباشرة من المستحقات التقاعدية، على ألا تتجاوز نسبة الحسم (25%).","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"military-retirement","legal_key":"10-bis","body_sha256":"9b29b4712c06d1d1ba9dfe47678eb19fd9b13a6c3f2951da6d89a0d2a00f99a9","archived_body_sha256":"9b29b4712c06d1d1ba9dfe47678eb19fd9b13a6c3f2951da6d89a0d2a00f99a9","source_path":"sources/hr-and-procurement/military-retirement-gosi.html","body_record_path":"legislation/human-resources/military-retirement/ARTICLE_SOURCE_INDEX.json","version_scope":"GOSI_HTML_snapshot_only; original_and_latest_amendment_inventory_unverified","verification_summary":{"official_match":{"status":"VERIFIED","label_ar":"موثق ضمن النطاق المسجل","scope":"GOSI36_HTML_entries_and_tables_only; no_original1395_or_current2026_consolidation_certificate","as_of":"2026-10-12","evidence":["legislation/human-resources/military-retirement/metadata.json"]},"amendments":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"اعتماد المالك للحصر منفصل عن الحصر المستقل","as_of":"2026-10-12","evidence":["legislation/human-resources/military-retirement/metadata.json"]},"publication":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"تاريخ النشر 1395/04/05هـ من صفحة BOE التي لصقها المالك؛ لا صورة لعدد أم القرى","as_of":"2026-10-12","evidence":["legislation/human-resources/military-retirement/VERIFICATION_DOSSIER.