{"t":"نظام التنفيذ أمام ديوان المظالم — منشور1443هـ","m":{"أداة الإصدار":"","الحالة":"نسخة مؤهلة للبحث؛ السريان والتطبيق الزمني يحتاجان تحققاً مستقلاً"},"h":"المادة 28","b":"المادة الثامنة والعشرون:\n1- لأي من أطراف التنفيذ أو المنازعة أن يطلب من دائرة التنفيذ وقف التنفيذ عند وجود غموض أو لبس في الحكم محل الطلب أو المنازعة يحول دون تنفيذه، وللدائرة أن تأمر بالوقف وذلك إلى حين الفصل في طلب تفسير الحكم من المحكمة المختصة.\n2- لأي من أطراف التنفيذ –عند صدور أمر وقف التنفيذ وفقاً لحكم الفقرة (1) من هذه المادة- التقدم إلى المحكمة المختصة بطلب التفسير خلال (خمسة عشر) يوماً من تاريخ التبليغ بأمر الوقف، على أن تشعر المحكمة المختصة دائرة التنفيذ بذلك.\n","eligible":true,"body_kind":"OFFICIAL_SNAPSHOT","instrument_id":"administrative-execution-law","legal_key":"28","body_sha256":"fcaa160848cbc72177473da41831cd59771d2d49ecffd3427d91f68bf1228798","archived_body_sha256":"fcaa160848cbc72177473da41831cd59771d2d49ecffd3427d91f68bf1228798","source_path":"sources/hr-and-procurement/administrative-execution-law.html","body_record_path":"legislation/regulations/administrative-execution-law/ARTICLE_SOURCE_INDEX.json","version_scope":"original_official_publication_only; later amendments and currentness open","verification_summary":{"official_match":{"status":"PARTIAL","label_ar":"تحقق جزئي","scope":"مطابقة HTML أو مقاطع أو مواد محددة؛اكتمال جميع المتون غير مثبت","as_of":"2026-10-12","evidence":["legislation/regulations/administrative-execution-law/metadata.json"]},"amendments":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"اعتماد المالك للحصر منفصل عن الحصر المستقل","as_of":"2026-10-12","evidence":["legislation/regulations/administrative-execution-law/metadata.json"]},"publication":{"status":"OWNER_ACCEPTED","label_ar":"مقبول من صاحب المشروع بحدود معلنة","scope":"تاريخ النشر من صفحة المالك وأم القرى؛ لا عدد جريدة","as_of":"2026-10-12","evidence":["legislation/regulations/administrative-execution-law/VERIFICATION_DOSSIER.json","sources/administrative-ex